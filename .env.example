# Server
PORT=3000
DATA_DIR=./data

# Durable processing history (optional until Phase 4).
# Connect Supabase in Settings -> Connect Supabase to have these injected.
# The app runs on local SQLite while they are absent; SQLite history is
# discarded when the container is redeployed (Free plan has no persistent disk).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional future LLM assist. Never required: the deterministic engine is default.
LLM_PROVIDER_URL=
LLM_API_KEY=
